# Spatial migration contract using synthetic GeoPackage and GeoTIFF fixtures.
require vgi

require-env DUCKS_WORKER

statement ok
LOAD spatial;

statement ok
SET geometry_always_xy=true;

statement ok
ATTACH 'ducks' (TYPE vgi, LOCATION '{DUCKS_WORKER}');

statement error
SELECT * FROM ducks.main.seasonal_ranges('mallar3');
----
Status and Trends access key required

statement ok
CREATE SECRET status_fixture (TYPE ebirdst, TOKEN 'status-fixture-token');

# season dates and year wrapping
query TTTIT
SELECT season,start_date,end_date,wraps_year::INTEGER,geometry_crs FROM ducks.main.seasonal_ranges('mallar3') ORDER BY season;
----
breeding	2023-05-17	2023-08-16	0	EPSG:4326
nonbreeding	2023-11-22	2023-03-08	1	EPSG:4326

# range spatial intersection with hole
query T
SELECT season FROM ducks.main.seasonal_ranges('mallar3') WHERE ST_Intersects(ST_GeomFromWKB(geometry_wkb),ST_Point(0.25,0.25)) ORDER BY season;
----
breeding

# range hole excludes point
query I
SELECT count(*) FROM ducks.main.seasonal_ranges('mallar3') WHERE ST_Contains(ST_GeomFromWKB(geometry_wkb),ST_Point(0.75,0.75));
----
0

# range polygon spatial join
query T
SELECT r.season FROM ducks.main.seasonal_ranges('mallar3') r JOIN (SELECT ST_GeomFromText('POLYGON((-1 -1,-0.5 -1,-0.5 -0.5,-1 -0.5,-1 -1))') geom) wetland ON ST_Intersects(ST_GeomFromWKB(r.geometry_wkb),wetland.geom) ORDER BY r.season;
----
nonbreeding

# season filter
query I
SELECT count(*) FROM ducks.main.seasonal_ranges('mallar3',season := 'resident');
----
0

# weekly relative abundance
query TRRIIR
SELECT week_date,mean_relative_abundance,max_relative_abundance,selected_cell_count,modeled_cell_count,round(coverage_fraction,6) FROM ducks.main.weekly_abundance('mallar3','POLYGON((-1 -1,2 -1,2 2,-1 2,-1 -1))') ORDER BY week_date;
----
2023-01-04	3.0	6.0	6	4	0.666667
2023-01-11	6.0	11.0	6	6	1.0
2023-01-18	NULL	NULL	6	0	0.0

# positive seasonal peak
query TR
SELECT week_date,mean_relative_abundance FROM ducks.main.migration_calendar('mallar3','POLYGON((-1 -1,2 -1,2 2,-1 2,-1 -1))') ORDER BY week_date;
----
2023-01-11	6.0

# empty geographic coverage
query TRIR
SELECT week_date,mean_relative_abundance,selected_cell_count,coverage_fraction FROM ducks.main.weekly_abundance('mallar3','POLYGON((40 40,41 40,41 41,40 41,40 40))') ORDER BY week_date;
----
2023-01-04	NULL	0	NULL
2023-01-11	NULL	0	NULL
2023-01-18	NULL	0	NULL

# empty peak calendar
query I
SELECT count(*) FROM ducks.main.migration_calendar('mallar3','POLYGON((40 40,41 40,41 41,40 41,40 40))');
----
0

# region WKB round trip
query RT
SELECT DISTINCT ST_Area(ST_GeomFromWKB(region_wkb)),geometry_crs FROM ducks.main.weekly_abundance('mallar3','POLYGON((-1 -1,2 -1,2 2,-1 2,-1 -1))') ORDER BY ALL;
----
9.0	EPSG:4326

# migration SQL schema
query TTT
SELECT typeof(geometry_wkb),typeof(prediction_year),typeof(wraps_year) FROM ducks.main.seasonal_ranges('mallar3') LIMIT 1;
----
BLOB	INTEGER	BOOLEAN

# unknown model product
statement error
SELECT * FROM ducks.main.seasonal_ranges('wooduc');
----
product unavailable

# NULL region
statement error
SELECT * FROM ducks.main.weekly_abundance('mallar3',NULL);
----
NULL

# invalid region shape
statement error
SELECT * FROM ducks.main.weekly_abundance('mallar3','POINT(0 0)');
----
POLYGON

# invalid crossed polygon
statement error
SELECT * FROM ducks.main.weekly_abundance('mallar3','POLYGON((0 0,2 2,0 2,2 0,0 0))');
----
non-self-intersecting

# dateline polygon
statement error
SELECT * FROM ducks.main.weekly_abundance('mallar3','POLYGON((-179 0,179 0,179 1,-179 1,-179 0))');
----
antimeridian

# path traversal species
statement error
SELECT * FROM ducks.main.seasonal_ranges('../mallar3');
----
species_code

# sample unsupported resolution
statement error
SELECT * FROM ducks.main.seasonal_ranges('yebsap-example',resolution := '9km');
----
sample

# NULL year
statement error
SELECT * FROM ducks.main.seasonal_ranges('mallar3',data_year := NULL);
----
NULL

statement ok
DROP SECRET status_fixture;

statement ok
CREATE SECRET wrong_status (TYPE ebirdst, TOKEN 'wrong-status-key');

statement error
SELECT * FROM ducks.main.seasonal_ranges('mallar3');
----
HTTP 401
